#!/usr/bin/env bash
#MISE description="Format YAML files with yamlfmt"
set -euo pipefail

yaml_files=$(git ls-files -co --exclude-standard '*.yaml' '*.yml')
if [ -n "$yaml_files" ]; then
  while IFS= read -r file; do
    yamlfmt "$file"
  done <<< "$yaml_files"
else
  echo "No standalone YAML files."
fi

