#!/usr/bin/env bash
#MISE description="Run JavaScript tests with the node:test builtin"
set -euo pipefail

# `node --test <dir>` exits 0 when it discovers nothing, so a test file renamed
# off the *.test.js pattern — or a tests/ directory that moves — would leave
# every caller (the pre-commit hook, CI) reporting green while running zero
# tests. Discover the files here and treat an empty set as a failure.
shopt -s nullglob
files=(skills/*/tests/*.test.js)
if [ ${#files[@]} -eq 0 ]; then
    echo "Error: no test files discovered under skills/*/tests/" >&2
    exit 1
fi

# A skill with npm dependencies installs them from its lockfile into a cache
# outside the skill directory (see its scripts/install-deps); mywiki has none.
for install in skills/*/scripts/install-deps; do
    node "$install"
done

# node:test has no per-test timeout by default, so one hung test (a child
# waiting on a prompt, a server that never answers) stalls the whole run, the
# pre-commit hook and CI with it. Two minutes is far past any test's runtime;
# a test that takes longer fails by name. A timed-out test still holding a
# live handle (that child, that server) keeps its file's process running, so
# --test-force-exit ends the run once every test has finished or timed out.
node --test --test-timeout=120000 --test-force-exit "${files[@]}"
