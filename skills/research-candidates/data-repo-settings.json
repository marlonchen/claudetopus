{
  "permissions": {
    "deny": [
      "Edit(/**/sources/**)",
      "Edit(/**/snapshots.sha256)",
      "Edit(/**/search-log/**)",
      "Edit(/**/ballot.ledger)",
      "Edit(/**/published.log)",
      "Edit(/downloads/**)",
      "Edit(/.bindings/**)",
      "Edit(/**/ballot-view.md)",
      "Edit(/addresses.yaml)",
      "Edit(/**/private.yaml)",
      "Read(/addresses.yaml)",
      "Read(/**/private.yaml)",
      "Read(/downloads/**)",
      "Read(/**/unfetchable.md)",
      "Bash(*fetch-snapshot*--ballot*)",
      "Bash(*fetch-snapshot*--keep-short*)",
      "Bash(*ballot-check*--show*)",
      "Bash(*publish*--show*)",
      "Bash(*publish*--push*)",
      "Bash(*publish*--device-check*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor|Read|Grep|Write|Edit|MultiEdit|NotebookEdit|Agent|Task|SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/research-candidates/scripts/session-guard\" || exit 2"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "research-candidates-discovery|research-candidates-compile|research-candidates-neutrality",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/research-candidates/scripts/session-guard\" || exit 2"
          }
        ]
      }
    ]
  }
}
